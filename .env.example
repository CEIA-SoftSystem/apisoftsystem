# Caminhos dos modelos (ajuste conforme seu ambiente)
# Desenvolvimento local (modelos na raiz do projeto):
# SEG_MODEL_PATH=unet_seg.pt
# DET_MODEL_PATH=best_yolo11
# Docker / EasyPanel (modelos montados em /app/models/):
SEG_MODEL_PATH=/app/models/unet_seg.pt
DET_MODEL_PATH=/app/models/best_yolo11

# Dispositivo: auto | cpu | cuda
DEVICE=auto

# Valores padrão para inferência
DEFAULT_THRESHOLD=0.5
DEFAULT_CONF=0.25

# Tamanho máximo de imagem aceito pela API (em MB)
MAX_IMAGE_SIZE_MB=10

# Debug mode
DEBUG=false
